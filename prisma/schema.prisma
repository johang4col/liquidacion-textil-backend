generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        String   @id
  nombre    String
  email     String   @unique
  password  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Cliente {
  id            String        @id @default(cuid())
  nombre        String
  nit           String?
  telefono      String?
  email         String?
  direccion     String?
  liquidaciones Liquidacion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("clientes")
}

model Liquidacion {
  id                      String              @id @default(cuid())
  numero                  String              @unique
  fecha                   DateTime
  clienteId               String
  cliente                 Cliente             @relation(fields: [clienteId], references: [id])
  ordenProduccion         String?
  referencia              String?
  materialPrincipal       String?
  observaciones           String?
  estado                  EstadoLiquidacion   @default(borrador)
  eliminada               Boolean             @default(false)
  // Checkboxes
  muestraFisica           Boolean             @default(false)
  retazosConfeccion       Boolean             @default(false)
  retazosConfeccionMetros Float?
  plantillas              Boolean             @default(false)
  // Procesos
  estampadoPiezas         Int?
  bordadoPiezas           Int?
  fusionadosPiezas        Int?
  // Registro tiqueteadas
  registroTiqueteadas     Json                @default("{}")
  // Despacho
  despachoPaquetes        Int?
  despachoRollos          Int?
  // Relaciones
  rollos                  Rollo[]
  fotos                   Foto[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([clienteId])
  @@index([numero])
  @@map("liquidaciones")
}

model Foto {
  id              String      @id @default(cuid())
  url             String
  publicId        String
  categoria       String?
  liquidacionId   String
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  @@index([liquidacionId])
  @@map("fotos")
}

model Rollo {
  id              String      @id @default(cuid())
  liquidacionId   String
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  numero          Int
  material        String
  metrosIniciales Float
  retazos         Float       @default(0)
  sesgos          Float       @default(0)
  ajuste          Float       @default(0)
  espigas         Espiga[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([liquidacionId])
  @@map("rollos")
}

model Espiga {
  id                 String   @id @default(cuid())
  rolloId            String
  rollo              Rollo    @relation(fields: [rolloId], references: [id], onDelete: Cascade)
  numero             Int
  largoTrazo         Float
  numeroCapas        Float
  distribucionTallas Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([rolloId])
  @@map("espigas")
}

model Configuracion {
  id                 String   @id @default(cuid())
  nombreEmpresa      String   @default("RED W & GOLD S.A.S")
  telefono           String   @default("320 694 81 38")
  nit                String?
  direccion          String?
  siguienteNumero    Int      @default(1)
  prefijoLiquidacion String   @default("")
  updatedAt          DateTime @updatedAt

  @@map("configuracion")
}

enum EstadoLiquidacion {
  borrador
  en_proceso
  finalizada
}
